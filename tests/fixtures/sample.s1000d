    <procedure><commonInfo><para>Isolate the private test system before beginning.</para></commonInfo><mainProcedure><proceduralStep><para>Remove the access panel.</para><note>Wear protective equipment.</note></proceduralStep><proceduralStep><para>Disconnect the pump.</para><warning>Verify zero pressure.</warning></proceduralStep></mainProcedure></procedure>
