ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Synthetic IFC4 tessellated geometry fixture'),'2;1');
FILE_NAME('sample.ifc','2026-09-14T00:00:00',(''),'','docsvg','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(2.,0.,0.),(2.,1.,0.),(0.,1.,0.),(0.,0.,1.),(2.,0.,1.),(2.,1.,1.),(0.,1.,1.)),$);
#2=IFCTRIANGULATEDFACESET(#1,$,.T.,((1,4,3),(1,3,2),(5,6,7),(5,7,8),(1,2,6),(1,6,5),(2,3,7),(2,7,6),(3,4,8),(3,8,7),(4,1,5),(4,5,8)),$);
#3=IFCSHAPEREPRESENTATION($,'Body','Tessellation',(#2));
#4=IFCPRODUCTDEFINITIONSHAPE($,$,(#3));
#5=IFCCARTESIANPOINT((10.,5.,0.));
#6=IFCDIRECTION((0.,0.,1.));
#7=IFCDIRECTION((0.,1.,0.));
#8=IFCAXIS2PLACEMENT3D(#5,#6,#7);
#9=IFCLOCALPLACEMENT($,#8);
#10=IFCBUILDINGELEMENTPROXY('2L$!TestElement',$,'Fixture box',$,$,#9,#4,$,$);
#11=IFCCARTESIANPOINT((25.,5.,0.));
#12=IFCAXIS2PLACEMENT3D(#11,#6,#7);
#13=IFCLOCALPLACEMENT($,#12);
#14=IFCBUILDINGELEMENTPROXY('2L$!SecondElement',$,'Second fixture box',$,$,#13,#4,$,$);
ENDSEC;
END-ISO-10303-21;
