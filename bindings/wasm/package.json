{
  "name": "document-svg-browser",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-only PDF and Office document previews using document-svg WebAssembly",
  "exports": {
    "./viewer": "./web/docsvg-viewer.js",
    "./worker": "./web/docsvg-worker.js",
    "./types": "./web/index.d.ts"
  },
  "files": [
    "web/docsvg-viewer.js",
    "web/docsvg-worker.js",
    "web/index.d.ts",
    "web/pkg",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build:wasm": "sh scripts/build-wasm.sh",
    "check:wasm": "cargo check --manifest-path Cargo.toml --target wasm32-unknown-unknown"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT OR Apache-2.0"
}
